# ---------------------------------------------------------------------------
# Configurazione di FarmacoMancante
# Copia questo file in .env (locale) oppure incolla le variabili nel pannello
# del servizio di hosting. Genera i segreti con:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Identità del sito (usate da SEO, sitemap, link social) -----------------
# URL pubblico canonico, senza slash finale.
# FARMACOMANCANTE_SITE_URL è letta a RUNTIME: preferiscila su PaaS e container,
# dove il dominio non è noto in fase di build (Render, Fly, VPS).
FARMACOMANCANTE_SITE_URL=https://farmacomancante.it
# Alternativa letta a build time (diventa parte del bundle JS).
# Usala solo se costruisci l'immagine già sapendo il dominio finale.
# NEXT_PUBLIC_SITE_URL=https://farmacomancante.it

# Indirizzo mostrato nel footer e nella privacy policy.
FARMACOMANCANTE_CONTACT_EMAIL=info@farmacomancante.it

# --- Sicurezza -------------------------------------------------------------
# Segreto per firmare i cookie di sessione. OBBLIGATORIO in produzione:
# cambiandolo si invalidano tutte le sessioni attive.
FARMACOMANCANTE_SECRET=cambiare-con-un-segreto-lungo-e-casuale

# Email che ottiene automaticamente il ruolo di amministratore.
FARMACOMANCANTE_ADMIN_EMAIL=admin@esempio.it

# Segreto Bearer per l'endpoint cron /api/cron/importa-aifa.
# Se omesso viene usato FARMACOMANCANTE_SECRET.
FARMACOMANCANTE_CRON_SECRET=cambiare-con-un-segreto-dedicato

# --- Dati ------------------------------------------------------------------
# Cartella del database SQLite e dei CSV (default: ./data).
# In container conviene un volume persistente, es. /data.
# FARMACOMANCANTE_DATA_DIR=/data

# --- Automazione -----------------------------------------------------------
# Disattiva lo schedulatore interno (utile in sviluppo o su hosting serverless
# dove l'import gira già tramite cron esterno):
# FARMACOMANCANTE_SCHEDULER=off
